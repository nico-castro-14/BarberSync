# ============================================================
# BarberSync PRO — Variables de entorno del FRONTEND (Vite)
# Copiar este archivo a `.env` y rellenar los valores reales.
# SOLO variables públicas: nunca colocar aquí la service_role key.
# ============================================================

# Supabase (Proyecto > Settings > API)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Endpoint de automatización WhatsApp (Supabase Edge Function o API externa).
# Si queda vacío, la app usa el modal simulado de WhatsApp como fallback visual.
# Edge Function incluida: supabase/functions/notify-whatsapp
VITE_WHATSAPP_WEBHOOK_URL=
# Secreto compartido opcional (debe coincidir con NOTIFY_WEBHOOK_SECRET de la función)
VITE_WHATSAPP_WEBHOOK_SECRET=
