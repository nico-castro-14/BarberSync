# ============================================================
# BarberSync PRO — Variables de entorno del BACKEND (guardian.py)
# Copiar este archivo a `backend/.env` y rellenar los valores.
# Este archivo contiene la SERVICE ROLE KEY: jamás exponerla al
# frontend ni subir el .env real al repositorio.
# ============================================================

# Supabase (Proyecto > Settings > API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# Clave compartida que protege los endpoints del guardián (header X-Guardian-Key)
GUARDIAN_API_KEY=genera-una-clave-larga-aleatoria

# Watcher en segundo plano
POLL_INTERVAL_SECONDS=30
PENDING_EXPIRATION_MINUTES=15

# Servidor Flask
GUARDIAN_PORT=5050
GUARDIAN_DEBUG=false
